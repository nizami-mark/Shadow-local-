# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BREVO_API_KEY: Required for sending transactional emails via Brevo.
BREVO_API_KEY=
BREVO_LIST_ID=2

# ZOHO SMTP CONFIGURATION
ZOHO_USER=
ZOHO_PASSWORD=
ZOHO_HOST=smtp.zoho.com
ZOHO_PORT=465

# OPTIONAL GENERIC SMTP BACKEND CONFIGURATION (e.g. Gmail, Zoho, etc.)
# If deploying to Vercel, set these environment variables in your Vercel Project Dashboard under Settings > Environment Variables:
# - SMTP_USER: Your Gmail address (e.g., nizami.shadowstudio@gmail.com)
# - SMTP_PASS: Your 16-character Gmail App Password (NOT your normal Gmail password. Generate this inside Google Account > Security > 2-Step Verification > App Passwords)
# - SMTP_HOST: smtp.gmail.com (The system auto-detects smtp.gmail.com if SMTP_USER ends with @gmail.com)
# - SMTP_PORT: 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
